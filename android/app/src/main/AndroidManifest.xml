<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: lets the game read /sdcard/Skate3Rust, which survives reinstalls. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:hasFragileUserData="true"
        android:theme="@style/Theme.Skate">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bevy cannot survive activity recreation, so every configuration
             change is handled in place and the game runs in its own task. -->
        <activity
            android:name=".SkateActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|colorMode"
            android:theme="@style/Theme.Skate.Game">
            <meta-data android:name="android.app.lib_name" android:value="skate3rust" />
        </activity>
    </application>
</manifest>
